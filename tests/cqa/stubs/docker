#!/usr/bin/env python3
"""Fake docker for the toolbox launcher tests: logs its argv, prints canned output.

CQA_STUB_LOG        file that receives one JSON array of arguments per call
CQA_STUB_FAIL       a call whose arguments, joined by spaces, contain this text exits non-zero
CQA_STUB_FAIL_CODE  exit code of those calls (default 1)
CQA_STUB_NO_DAEMON  "version" fails, as when the daemon is down
CQA_STUB_NO_LOGIN   "manifest inspect" fails, as without a registry login
CQA_STUB_MISSING    comma-separated image names that "image inspect" does not find
CQA_STUB_VERSION    version label given by "image inspect" (default 1.2.3)
CQA_STUB_OUT        text a named container ("run --name ...") prints on stdout
CQA_STUB_ERR        text a named container prints on stderr
CQA_STUB_RUN_CODE   exit code of a named container (default 0)
CQA_STUB_HANG       a named container never ends by itself: "kill <name>" ends it (as SIGKILL)
CQA_STUB_CI_JSON    JSON printed by the container that reads /repo/.gitlab-ci.yml
"""
import json
import os
import signal
import sys
import time

args = sys.argv[1:]
log = os.environ.get("CQA_STUB_LOG")
if log:
    with open(log, "a", encoding="utf-8") as handle:
        handle.write(json.dumps(args) + "\n")

for index, arg in enumerate(args[:-1]):
    if arg == "-v" and args[index + 1].startswith("/"):
        host, _, target = args[index + 1].partition(":")
        # Only the read-only input of "secrets" is a file; every other bind source is a folder.
        expected = os.path.isfile if target == "/in/input:ro" else os.path.isdir
        if not expected(host):
            sys.stderr.write("stub: bind mount source is not a " + ("file" if target == "/in/input:ro" else "directory") + ": " + host + "\n")
            sys.exit(99)

needle = os.environ.get("CQA_STUB_FAIL")
if needle and needle in " ".join(args):
    sys.stderr.write("stub: forced failure\n")
    sys.exit(int(os.environ.get("CQA_STUB_FAIL_CODE", "1")))

if args[:1] == ["version"]:
    if os.environ.get("CQA_STUB_NO_DAEMON"):
        sys.stderr.write("Cannot connect to the Docker daemon\n")
        sys.exit(1)
    print("27.0.1")
elif args[:2] == ["manifest", "inspect"]:
    if os.environ.get("CQA_STUB_NO_LOGIN"):
        sys.stderr.write("unauthorized\n")
        sys.exit(1)
    print("{}")
elif args[:2] == ["image", "inspect"]:
    name = args[-1].rsplit("/", 1)[-1].split(":")[0]
    if name in os.environ.get("CQA_STUB_MISSING", "").split(","):
        sys.stderr.write("No such image\n")
        sys.exit(1)
    print(os.environ.get("CQA_STUB_VERSION", "1.2.3"))
elif args[:2] == ["network", "create"]:
    print("0123456789ab")
elif args[:1] == ["ps"]:
    print("CONTAINER ID   NAMES")
elif args[:1] == ["kill"]:
    pidfile = f"{log}.{args[1]}.pid" if log and len(args) > 1 else ""
    if not pidfile or not os.path.exists(pidfile):
        sys.stderr.write("Error response from daemon: No such container\n")
        sys.exit(1)
    with open(pidfile, encoding="utf-8") as handle:
        os.kill(int(handle.read()), signal.SIGKILL)
    print(args[1])
elif args[:1] == ["run"] and "--name" in args:
    name = args[args.index("--name") + 1]
    sys.stdout.write(os.environ.get("CQA_STUB_OUT", ""))
    sys.stderr.write(os.environ.get("CQA_STUB_ERR", ""))
    sys.stdout.flush()
    sys.stderr.flush()
    if os.environ.get("CQA_STUB_HANG") and log:
        with open(f"{log}.{name}.pid", "w", encoding="utf-8") as handle:
            handle.write(str(os.getpid()))
        time.sleep(60)
    sys.exit(int(os.environ.get("CQA_STUB_RUN_CODE", "0")))
elif args[:1] == ["run"] and "/repo/.gitlab-ci.yml" in args:
    print(os.environ.get("CQA_STUB_CI_JSON", '{"stages":["build"]}'), end="")
elif args[:1] == ["run"] and "lint" in args:
    print('{"problems": []}')
elif args[:1] == ["run"] and any("gitleaks stdin" in arg for arg in args):
    # The secrets command: the report goes to the /out mount, as gitleaks would write it.
    for index, arg in enumerate(args[:-1]):
        if arg == "-v" and args[index + 1].endswith(":/out"):
            report = os.path.join(args[index + 1].split(":")[0], "gitleaks.json")
            with open(report, "w", encoding="utf-8") as handle:
                handle.write(os.environ.get("CQA_STUB_GITLEAKS", "[]"))
