{
  "description": "Reminds the session that the Checklist Qualité GM applies to every dev task in a client project.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/quality-reminder.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
